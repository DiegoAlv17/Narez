---
import { landingData } from '../data/landing';
---

<header id="main-header" class="fixed left-0 top-1/2 z-[70] -translate-y-1/2 max-md:top-4 max-md:translate-y-0">
  <button
    type="button"
    class="header-menu-toggle group flex h-20 w-[7.75rem] flex-col items-center justify-center gap-2 rounded-r-[2.5rem] border border-l-0 border-white/20 bg-neutral-950/80 text-white shadow-[0_12px_30px_rgb(0_0_0_/_25%)] backdrop-blur-md outline-none transition-colors hover:border-[var(--narez-metal)] hover:text-[var(--narez-metal)] focus-visible:ring-2 focus-visible:ring-[var(--narez-metal)] focus-visible:ring-offset-4 focus-visible:ring-offset-neutral-950"
    data-menu-toggle
    aria-controls="site-menu"
    aria-expanded="false"
    aria-label="Abrir menu"
  >
    <span class="header-menu-bars flex w-9 flex-col gap-[5px]" aria-hidden="true">
      <span class="menu-bar block h-[2px] w-full bg-current"></span>
      <span class="menu-bar block h-[2px] w-7 self-end bg-current"></span>
      <span class="menu-bar block h-[2px] w-full bg-current"></span>
    </span>
    <span class="header-menu-label text-[0.6rem] font-semibold uppercase tracking-[0.28em]">Menu</span>
  </button>
</header>

<div
  class="menu-backdrop pointer-events-none invisible fixed inset-0 z-[55] bg-black/75 opacity-0"
  data-menu-backdrop
  aria-hidden="true"
></div>

<aside
  id="site-menu"
  class="menu-panel pointer-events-none invisible fixed inset-y-0 left-0 z-[60] flex w-[min(34rem,92vw)] overflow-hidden border-r border-neutral-800 bg-neutral-950 text-white opacity-0 max-md:w-full"
  data-menu-panel
  aria-hidden="true"
>
  <svg class="menu-strokes pointer-events-none absolute inset-0 h-full w-full" viewBox="0 0 600 1000" preserveAspectRatio="none" aria-hidden="true">
    <path d="M-80 170C120 40 320 70 700-80" fill="none" stroke="var(--narez-metal)" stroke-width="1.5" opacity="0.7" />
    <path d="M-140 820C60 650 280 690 680 420" fill="none" stroke="var(--narez-paper)" stroke-width="1" opacity="0.28" />
    <path d="M270 1060C270 820 410 650 650 580" fill="none" stroke="var(--narez-metal)" stroke-width="1" opacity="0.5" />
    <circle cx="520" cy="170" r="92" fill="none" stroke="var(--narez-paper)" stroke-width="1" opacity="0.16" />
    <circle cx="520" cy="170" r="5" fill="var(--narez-metal)" opacity="0.8" />
  </svg>

  <div class="menu-panel-content relative z-10 flex min-h-full w-full flex-col justify-center px-10 py-16 max-md:px-7">
    <nav aria-label="Navegacion principal">
      <a href="/" class="menu-item group flex items-center justify-between border-t border-neutral-800 py-5 outline-none transition-colors hover:border-[var(--narez-metal)] focus-visible:border-[var(--narez-metal)]" data-menu-item>
        <span class="menu-item-label text-3xl font-semibold uppercase tracking-tight transition-transform duration-300 group-hover:translate-x-2">Inicio</span>
        <svg class="h-6 w-6 text-[var(--narez-metal)] opacity-0 transition-all duration-300 group-hover:translate-x-1 group-hover:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h13m-6-6 6 6-6 6" /></svg>
      </a>
      {landingData.navItems.map((item) => (
        <a href={item.href} class="menu-item group flex items-center justify-between border-t border-neutral-800 py-5 outline-none transition-colors hover:border-[var(--narez-metal)] focus-visible:border-[var(--narez-metal)]" data-menu-item>
          <span class="menu-item-label text-3xl font-semibold uppercase tracking-tight transition-transform duration-300 group-hover:translate-x-2">{item.label}</span>
          <svg class="h-6 w-6 text-[var(--narez-metal)] opacity-0 transition-all duration-300 group-hover:translate-x-1 group-hover:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h13m-6-6 6 6-6 6" /></svg>
        </a>
      ))}
      <a href="#contacto" class="menu-item group flex items-center justify-between border-y border-neutral-800 py-5 outline-none transition-colors hover:border-[var(--narez-metal)] focus-visible:border-[var(--narez-metal)]" data-menu-item>
        <span class="menu-item-label text-3xl font-semibold uppercase tracking-tight transition-transform duration-300 group-hover:translate-x-2">Contacto</span>
        <svg class="h-6 w-6 text-[var(--narez-metal)] opacity-0 transition-all duration-300 group-hover:translate-x-1 group-hover:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h13m-6-6 6 6-6 6" /></svg>
      </a>
    </nav>
  </div>
</aside>

<script>
  import { gsap } from "gsap";

  const toggle = document.querySelector<HTMLElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
  const backdrop = document.querySelector<HTMLElement>("[data-menu-backdrop]");
  const bars = toggle?.querySelectorAll<HTMLElement>(".menu-bar");
  const menuItems = panel?.querySelectorAll<HTMLElement>("[data-menu-item]");
  const panelContent = panel?.querySelector<HTMLElement>(".menu-panel-content");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const isMobile = window.matchMedia("(max-width: 767px)").matches;
  const duration = (value: number) => (reduceMotion ? 0 : value);
  const browserScale = () => Number(getComputedStyle(document.documentElement).getPropertyValue("--narez-zoom-scale") || 1);
  const scaled = (value: number) => value * browserScale();

  if (toggle && panel && backdrop && bars && menuItems && panelContent) {
    let isOpen = false;
    let previousBodyOverflow = "";
    let previousFocus: HTMLElement | null = null;

    gsap.set(panel, { xPercent: -100, autoAlpha: 0 });
    gsap.set(backdrop, { autoAlpha: 0 });
    gsap.set(panelContent, { x: scaled(-24), autoAlpha: 0 });
    gsap.set(menuItems, { x: scaled(-28), autoAlpha: 0 });

    const setMenuState = (open: boolean) => {
      isOpen = open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menu" : "Abrir menu");
      panel.setAttribute("aria-hidden", String(!open));
      backdrop.setAttribute("aria-hidden", String(!open));
      document.documentElement.classList.toggle("menu-is-open", open);

      if (open) {
        previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        previousBodyOverflow = document.body.style.overflow;
        document.body.style.overflow = "hidden";
        panel.classList.remove("pointer-events-none", "invisible");
        backdrop.classList.remove("pointer-events-none", "invisible");
        toggle.focus({ preventScroll: true });
      } else {
        document.body.style.overflow = previousBodyOverflow;
        previousFocus?.focus({ preventScroll: true });
      }
    };

    const openMenu = () => {
      if (isOpen) return;
      setMenuState(true);

      const toggleY = isMobile ? 0 : -(window.innerHeight / 2 - scaled(56));
      const timeline = gsap.timeline({ defaults: { ease: "power2.out" } });
      timeline
        .to(backdrop, { autoAlpha: 1, duration: duration(0.18) }, 0)
        .to(panel, { xPercent: 0, autoAlpha: 1, duration: duration(0.45), ease: "power3.out" }, 0)
        .to(panelContent, { x: 0, autoAlpha: 1, duration: duration(0.28) }, 0.04)
        .to(menuItems, { x: 0, autoAlpha: 1, duration: duration(0.24), stagger: reduceMotion ? 0 : 0.04 }, 0.08)
        .to(toggle, { y: toggleY, duration: duration(0.28) }, 0)
        .to(bars[0], { rotation: 45, y: scaled(7), duration: duration(0.2) }, 0)
        .to(bars[1], { autoAlpha: 0, x: scaled(-8), duration: duration(0.16) }, 0)
        .to(bars[2], { rotation: -45, y: scaled(-7), duration: duration(0.2) }, 0);
    };

    const closeMenu = () => {
      if (!isOpen) return;
      setMenuState(false);

      const timeline = gsap.timeline({
        defaults: { ease: "power2.inOut" },
        onComplete: () => {
          panel.classList.add("pointer-events-none", "invisible");
          backdrop.classList.add("pointer-events-none", "invisible");
          gsap.set(panel, { autoAlpha: 0 });
          gsap.set(backdrop, { autoAlpha: 0 });
          gsap.set(panelContent, { x: scaled(-24), autoAlpha: 0 });
          gsap.set(menuItems, { x: scaled(-28), autoAlpha: 0 });
        },
      });
      timeline
        .to([menuItems, panelContent], { x: scaled(-18), autoAlpha: 0, duration: duration(0.18), stagger: reduceMotion ? 0 : 0.015 }, 0)
        .to(panel, { xPercent: -100, duration: duration(0.36), ease: "power2.in" }, 0)
        .to(backdrop, { autoAlpha: 0, duration: duration(0.2) }, 0)
        .to(toggle, { y: 0, duration: duration(0.22) }, 0)
        .to(bars[0], { rotation: 0, y: 0, duration: duration(0.18) }, 0)
        .to(bars[1], { autoAlpha: 1, x: 0, duration: duration(0.14) }, 0)
        .to(bars[2], { rotation: 0, y: 0, duration: duration(0.18) }, 0);
    };

    toggle.addEventListener("click", () => (isOpen ? closeMenu() : openMenu()));
    backdrop.addEventListener("click", closeMenu);
    panel.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });
  }
</script>

<style>
  @media (min-width: 768px) {
    .header-menu-toggle {
      width: calc(7.75rem * var(--narez-browser-scale, 1));
      height: calc(5rem * var(--narez-browser-scale, 1));
      gap: calc(0.5rem * var(--narez-browser-scale, 1));
      border-top-right-radius: calc(2.5rem * var(--narez-browser-scale, 1));
      border-bottom-right-radius: calc(2.5rem * var(--narez-browser-scale, 1));
    }

    .header-menu-bars {
      width: calc(2.25rem * var(--narez-browser-scale, 1));
      gap: calc(0.3125rem * var(--narez-browser-scale, 1));
    }

    .header-menu-bars .menu-bar {
      height: calc(2px * var(--narez-browser-scale, 1));
    }

    .header-menu-bars .menu-bar:nth-child(2) {
      width: calc(1.75rem * var(--narez-browser-scale, 1));
    }

    .header-menu-label {
      font-size: calc(0.6rem * var(--narez-browser-scale, 1));
    }

    .menu-panel {
      width: min(calc(34rem * var(--narez-browser-scale, 1)), 92vw);
    }

    .menu-panel-content {
      padding: calc(4rem * var(--narez-browser-scale, 1)) calc(2.5rem * var(--narez-browser-scale, 1));
    }

    .menu-item {
      padding-top: calc(1.25rem * var(--narez-browser-scale, 1));
      padding-bottom: calc(1.25rem * var(--narez-browser-scale, 1));
    }

    .menu-item-label {
      font-size: calc(1.875rem * var(--narez-browser-scale, 1));
    }

    .menu-item > svg {
      width: calc(1.5rem * var(--narez-browser-scale, 1));
      height: calc(1.5rem * var(--narez-browser-scale, 1));
    }
  }
</style>
