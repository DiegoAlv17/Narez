---
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="footer-section relative pt-24 pb-12 text-[var(--narez-ink)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 border-b border-neutral-300 pb-16 md:grid-cols-12 lg:gap-8">
      <div class="md:col-span-5 lg:col-span-6">
        <a href="/" class="group inline-flex items-center gap-3" aria-label={`Ir al inicio - ${siteConfig.name}`}>
          <img src="/logo.svg" alt={`Logo de ${siteConfig.name}`} class="relative z-10 h-10 w-auto brightness-0 transition-transform duration-300 group-hover:scale-110" />
          <span class="max-w-0 -translate-x-4 overflow-hidden whitespace-nowrap text-3xl font-semibold uppercase tracking-tighter text-neutral-950 opacity-0 transition-all duration-500 group-hover:max-w-[200px] group-hover:translate-x-0 group-hover:opacity-100">{siteConfig.name}</span>
        </a>
        <p class="mt-8 max-w-sm text-lg font-medium leading-relaxed text-neutral-600">
          {siteConfig.description}
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 md:col-span-7 lg:col-span-6">
        <div>
          <h2 class="mb-6 text-xs font-semibold uppercase tracking-widest text-neutral-500">Navegación</h2>
          <ul class="space-y-4">
            <li><a href="#servicios" class="text-sm font-semibold uppercase text-neutral-700 transition-colors hover:text-neutral-950">Servicios</a></li>
            <li><a href="#proceso" class="text-sm font-semibold uppercase text-neutral-700 transition-colors hover:text-neutral-950">Proceso</a></li>
            <li><a href="#contacto" class="text-sm font-semibold uppercase text-neutral-700 transition-colors hover:text-neutral-950">Contacto</a></li>
          </ul>
        </div>
        <div>
          <h2 class="mb-6 text-xs font-semibold uppercase tracking-widest text-neutral-500">Redes</h2>
          <ul class="space-y-4">
            <li><a href={siteConfig.social.twitter} class="text-sm font-semibold uppercase text-neutral-700 transition-colors hover:text-neutral-950" target="_blank" rel="noopener noreferrer">Twitter X</a></li>
            <li><a href={siteConfig.social.github} class="text-sm font-semibold uppercase text-neutral-700 transition-colors hover:text-neutral-950" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start md:flex-row md:items-center md:justify-between">
      <p class="text-sm font-bold uppercase tracking-wider text-neutral-600">
        &copy; {currentYear} {siteConfig.name}. Todos los derechos reservados.
      </p>
      <div class="mt-4 flex space-x-6 md:mt-0" aria-label="Documentos legales">
        <span class="cursor-default text-xs font-bold uppercase tracking-wider text-neutral-500" title="Contenido disponible próximamente">Aviso de Privacidad</span>
        <span class="cursor-default text-xs font-bold uppercase tracking-wider text-neutral-500" title="Contenido disponible próximamente">Términos de Uso</span>
      </div>
    </div>
  </div>
</footer>
