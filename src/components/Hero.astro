<script>
  import { gsap } from "gsap";

  const visual = document.querySelector(".hero-visual");
  const pattern = visual?.querySelector<SVGElement>(".hero-pattern");
  const patternLineGroups = pattern?.querySelectorAll<SVGGElement>(".hero-pattern-line-group");
  const patternCircles = pattern?.querySelectorAll<SVGCircleElement>("circle");
  const browserScale = () => Number(getComputedStyle(document.documentElement).getPropertyValue("--narez-zoom-scale") || 1);

  if (visual && pattern && patternLineGroups && patternCircles) {
    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const scale = browserScale();

      gsap.set(patternLineGroups, {
        transformOrigin: "50% 50%",
      });
      gsap.set(patternCircles, {
        transformOrigin: "50% 50%",
      });

      const lineDrift = gsap.timeline({
        repeat: -1,
        yoyo: true,
        defaults: { ease: "sine.inOut" },
      });
      lineDrift
        .to(patternLineGroups[0], { x: 18 * scale, y: 8 * scale, duration: 8 }, 0)
        .to(patternLineGroups[1], { x: -14 * scale, y: -10 * scale, duration: 10 }, 0)
        .to(patternLineGroups[2], { x: 12 * scale, y: -14 * scale, duration: 9 }, 0)
        .to(patternLineGroups[3], { x: -16 * scale, y: 12 * scale, duration: 11 }, 0);

      const circlePulse = gsap.to(patternCircles, {
        scale: 1.08,
        duration: 3.6,
        ease: "sine.inOut",
        repeat: -1,
        yoyo: true,
        stagger: 0.3,
      });

      const visibilityObserver = new IntersectionObserver(([entry]) => {
        if (entry?.isIntersecting) {
          lineDrift.resume();
          circlePulse.resume();
        } else {
          lineDrift.pause();
          circlePulse.pause();
        }
      }, { rootMargin: "120px 0px" });

      visibilityObserver.observe(visual);

      return () => {
        visibilityObserver.disconnect();
        lineDrift.kill();
        circlePulse.kill();
      };
    });

    mm.add("(prefers-reduced-motion: reduce)", () => {
      gsap.set(patternLineGroups, { x: 0, y: 0 });
      gsap.set(patternCircles, { scale: 1 });
    });
  }
</script>

