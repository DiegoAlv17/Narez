---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CreationScroll from '../components/CreationScroll.astro';
import Features from '../components/Features.astro';
import Process from '../components/Process.astro';
import Finale from '../components/Finale.astro';
import { siteConfig } from '../config/site';

const pageTitle = `${siteConfig.name} | Soluciones Digitales`;
---

<Layout title={pageTitle} description={siteConfig.description}>
  <Header />
  <main class="flex-grow">
    <Hero />
    <CreationScroll />
    <Features />
    <Process />
    <Finale />
  </main>
</Layout>
